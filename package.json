{
	"name": "06-atmo-watch",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.30.1",
	"scripts": {
		"atproto:setup": "atproto-oauth setup",
		"atproto:keygen": "atproto-oauth keygen",
		"atproto:secret": "atproto-oauth secret",
		"contrail:generate": "contrail connect api --out src/lib/contrail/lexicons --client src/lib/contrail/index.ts --client-types src/lib/contrail/types/index.ts",
		"contrail:update:prod": "contrail connect https://api.atmo.watch --out src/lib/contrail/lexicons --update --no-generate && pnpm run contrail:generate",
		"dev": "vite dev",
		"dev:prod": "vite dev",
		"dev:local": "CONTRAIL_URL=http://127.0.0.1:8787 vite dev",
		"dev:stack": "pnpm --parallel --filter . --filter @atmo-watch/api run dev:local",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"api:dev": "pnpm --dir api dev",
		"api:check": "pnpm --dir api check",
		"api:deploy": "pnpm --dir api run deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"og:generate": "node --env-file-if-exists=.env scripts/generate-og-image.ts",
		"videos:find": "node --env-file-if-exists=.env scripts/find-videos.ts",
		"videos:upload": "node --env-file-if-exists=.env scripts/upload-videos.ts",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource/inter": "^5.3.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.123.0"
	},
	"dependencies": {
		"@atcute/atproto": "^4.0.0",
		"@atcute/client": "^5.1.1",
		"@atcute/lexicons": "^2.0.3",
		"@atcute/password-session": "^1.0.2",
		"@atmo-dev/contrail": "^0.21.2",
		"@earendil-works/pi-coding-agent": "^0.84.2",
		"@ethercorps/sveltekit-og": "^4.3.0",
		"@foxui/core": "^0.9.1",
		"@foxui/social": "^0.8.10",
		"@lorenzopant/tmdb": "^1.25.3",
		"@lucide/svelte": "^1.31.0",
		"@svelte-atproto/oauth": "^0.3.0",
		"add": "^2.0.9",
		"bits-ui": "^2.18.1",
		"typebox": "^1.3.17",
		"valibot": "^1.0.0",
		"youtubei.js": "^18.0.0"
	}
}
