{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "atmo-watch",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-15",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"ORIGIN": "https://atmo.watch"
	},
	"routes": [
		{
			"pattern": "atmo.watch",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			// Retain the existing projection and ordered-source epoch during cutover.
			"database_name": "atmo-watch-contrail-g20261026",
			"database_id": "93dbdac8-57a5-4485-b884-f12899122a69"
		}
	],
	"triggers": {
		"crons": ["*/1 * * * *"]
	},
	"kv_namespaces": [
		{
			"binding": "OAUTH_SESSIONS",
			"id": "2550afd2ce4a4c94bbe1b7cfe03ffd20"
		},
		{
			"binding": "OAUTH_STATES",
			"id": "7221735865774a349e4d73f89b9c51af"
		},
		{
			"binding": "MEDIA_CACHE",
			"id": "658896e538fd40f498ef85e49ed560d2"
		}
	]
}
