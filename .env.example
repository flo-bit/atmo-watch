TMDB_ACCESS_TOKEN=
OMDB_API_KEY=
# Additional comma- or whitespace-separated DIDs allowed to use media artwork /edit pages
MEDIA_CURATOR_DIDS=

# Video uploader (single-account mode; use numbered variables for a multi-account config)
ATPROTO_IDENTIFIER=
ATPROTO_APP_PASSWORD=
ATPROTO_SERVICE=https://bsky.social

# Scheduled ingestion: put CRON_SECRET in .dev.vars locally and use
# `wrangler secret put CRON_SECRET` in production (never commit the value).

# @svelte-atproto/oauth
ORIGIN=
COOKIE_SECRET=
CLIENT_ASSERTION_KEY=
