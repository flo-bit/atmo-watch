{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "atmo-watch-api",
	"main": "src/worker.ts",
	"compatibility_date": "2026-08-15",
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "api.atmo.watch",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "atmo-watch-contrail-g20261026",
			"database_id": "93dbdac8-57a5-4485-b884-f12899122a69"
		}
	],
	"triggers": {
		"crons": ["*/1 * * * *"]
	}
}
