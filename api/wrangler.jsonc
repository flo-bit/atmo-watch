{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "atmo-watch-api",
	"main": "src/worker.ts",
	"compatibility_date": "2026-08-15",
	"observability": {
		"enabled": true
	},
	"vars": {
		"CONTRAIL_PUBLIC_ENDPOINT": "https://api.atmo.watch"
	},
	"routes": [
		{
			"pattern": "api.atmo.watch",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "atmo-watch-contrail-g20260819",
			"database_id": "e95b62d4-4875-4856-97cd-e41359bba330"
		}
	],
	"triggers": {
		"crons": ["*/1 * * * *"]
	}
}
