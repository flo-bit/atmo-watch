{
  "defs": {
    "main": {
      "description": "Check for community reviews (including rating-only records), exact-title videos and TV descendant videos without hydration or aggregation.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "hasDescendantVideos": {
              "type": "boolean"
            },
            "hasReviews": {
              "type": "boolean"
            },
            "hasVideos": {
              "type": "boolean"
            }
          },
          "required": [
            "hasReviews",
            "hasVideos",
            "hasDescendantVideos"
          ],
          "type": "object"
        }
      },
      "parameters": {
        "properties": {
          "creativeWorkType": {
            "knownValues": [
              "movie",
              "tv_show"
            ],
            "type": "string"
          },
          "tmdbId": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "creativeWorkType",
          "tmdbId"
        ],
        "type": "params"
      },
      "type": "query"
    }
  },
  "id": "watch.atmo.review.getCommunityPresence",
  "lexicon": 1
}
