    "main": {
      "description": "Get a social.popfeed.feed.review record by AT URI",
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "cid": {
              "format": "cid",
              "type": "string"
            },
            "collection": {
              "format": "nsid",
              "type": "string"
            },
            "comments": {
              "items": {
                "ref": "#hydrateCommentsRecord",
                "type": "ref"
              },
              "type": "array"
            },
            "commentsCount": {
              "description": "Total comments count",
              "type": "integer"
            },
            "did": {
              "format": "did",
              "type": "string"
            },
            "likes": {
              "items": {
                "ref": "#hydrateLikesRecord",
                "type": "ref"
              },
              "type": "array"
            },
            "likesCount": {
              "description": "Total likes count",
              "type": "integer"
            },
            "profiles": {
              "items": {
                "ref": "#profileEntry",
                "type": "ref"
              },
              "type": "array"
            },
            "rkey": {
              "type": "string"
            },
            "time_us": {
              "type": "integer"
            },
            "uri": {
              "format": "at-uri",
              "type": "string"
            },
            "value": {
              "ref": "social.popfeed.feed.review#main",
              "type": "ref"
            }
          },
          "required": [
            "uri",
            "value",
            "did",
            "collection",
            "rkey",
            "time_us"
          ],
          "type": "object"
        }
      },
      "parameters": {
        "properties": {
          "hydrateComments": {
            "description": "Number of comments records to embed",
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "hydrateLikes": {
            "description": "Number of likes records to embed",
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "profiles": {
            "description": "Include indexed profile and identity information",
            "type": "boolean"
          },
          "uri": {
            "description": "AT URI of the record",
            "format": "at-uri",
            "type": "string"
          }
        },
        "required": [
          "uri"
        ],
        "type": "params"
      },
      "type": "query"
    },
